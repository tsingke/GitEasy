        <mxCell id="normal" value="主工作树/.git：常规管理目录" style="shape=folder;fillColor=#EEF7F7;strokeColor=#087F78;html=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="300" height="110" as="geometry" />
