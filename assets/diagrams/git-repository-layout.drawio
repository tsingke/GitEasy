        </mxCell>
        <mxCell id="note-2" value="保存对象：objects按内容标识组织数据，目录名称与项目路径不同。" style="rounded=1;fillColor=#F3F8FC;strokeColor=#CAD8E3;html=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="600" y="480" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note-3" value="提供名称：refs示意松散引用；打包或其他后端可改变保存形式。" style="rounded=1;fillColor=#F3F8FC;strokeColor=#CAD8E3;html=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1">
