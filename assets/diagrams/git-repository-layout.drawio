        <mxCell id="note-0" value="定位入口：HEAD关联当前位置；config提供仓库级配置。" style="rounded=1;fillColor=#F3F8FC;strokeColor=#CAD8E3;html=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="选择候选：index通过条目组织候选内容。读取使用Git查询接口。" style="rounded=1;fillColor=#F3F8FC;strokeColor=#CAD8E3;html=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1">
