        <mxCell id="note-4" value="记录移动：logs保存已启用的本地引用日志，保留受配置和维护影响。" style="rounded=1;fillColor=#F3F8FC;strokeColor=#CAD8E3;html=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="1">
