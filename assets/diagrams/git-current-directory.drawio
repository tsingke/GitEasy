        </mxCell>
        <mxCell id="pwd" value="pwd：确认当前目录&#10;用户主目录/git-study" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fontSize=16;fillColor=#F0F6FC;strokeColor=#155DA6;">
